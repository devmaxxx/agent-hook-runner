{
  "name": "agent-hook-runner",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.23.0",
  "description": "Run Claude Code and Codex hooks from a stable copy on a Node.js that fits: survives Node upgrades, nvm switches and rebuilds, with a per-hook fail mode. Zero dependencies.",
  "author": "devmaxxx",
  "license": "MIT",
  "homepage": "https://github.com/devmaxxx/agent-hook-runner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devmaxxx/agent-hook-runner.git"
  },
  "bugs": {
    "url": "https://github.com/devmaxxx/agent-hook-runner/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agent",
    "hooks",
    "pretooluse",
    "node",
    "nvm",
    "fnm",
    "volta",
    "launcher"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "agent-hook-runner": "./dist/cli.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^5.0.5"
  }
}
